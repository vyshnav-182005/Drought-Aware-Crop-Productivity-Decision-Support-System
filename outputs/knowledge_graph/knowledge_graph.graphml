  <data key="d10">Insect : Thrips : Profenophos @2 ml/ L Disease: Alternaria/ Cercospora : Mancozeb spray 0.25 % or 0.1 % Carbendazim or 0.25 % chlorothalonil</data>
  <data key="d11"></data>
