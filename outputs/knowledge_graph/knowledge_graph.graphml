  <data key="d0">Action</data>
  <data key="d6">action_6cbe5e8e5e</data>
  <data key="d8"></data>
  <data key="d9"></data>
  <data key="d10">i) Fruit sucking moth - Protect the fruits either by bagging or by using repellents i) Bacterial spot – Spraying of bactinashak 250 ppm (2.5 g / 10 lit.) and captaf 0.25 % alternatively</data>
  <data key="d11"></data>
  <data key="d12"></data>
  <data key="d13"></data>
  <data key="d14">plant_protection</data>
  <data key="d15">plant_protection</data>
</node>
