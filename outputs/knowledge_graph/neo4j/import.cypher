// Generated by export_neo4j.py -- run after copying the CSVs to Neo4j's import/ folder

CREATE CONSTRAINT action_key IF NOT EXISTS FOR (n:Action) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT condition_key IF NOT EXISTS FOR (n:Condition) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT conditiondetail_key IF NOT EXISTS FOR (n:ConditionDetail) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT crop_key IF NOT EXISTS FOR (n:Crop) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT district_key IF NOT EXISTS FOR (n:District) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT season_key IF NOT EXISTS FOR (n:Season) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT seasonrecord_key IF NOT EXISTS FOR (n:SeasonRecord) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT soiltype_key IF NOT EXISTS FOR (n:SoilType) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT year_key IF NOT EXISTS FOR (n:Year) REQUIRE n.key IS UNIQUE;

LOAD CSV WITH HEADERS FROM 'file:///nodes_Action.csv' AS row
MERGE (n:Action {key: row.key})
SET n.action_category = row.action_category, n.action_types = row.action_types, n.agronomic_measures = row.agronomic_measures, n.change_in_cropping = row.change_in_cropping, n.code = row.code, n.crop_management = row.crop_management, n.rabi_crop_planning = row.rabi_crop_planning, n.remarks = row.remarks, n.soil_moisture_conservation = row.soil_moisture_conservation;

LOAD CSV WITH HEADERS FROM 'file:///nodes_Condition.csv' AS row
MERGE (n:Condition {key: row.key})
SET n.category = row.category, n.code = row.code, n.description = row.description, n.name = row.name;

LOAD CSV WITH HEADERS FROM 'file:///nodes_ConditionDetail.csv' AS row
MERGE (n:ConditionDetail {key: row.key})
SET n.category = row.category, n.code = row.code, n.crop_stage = row.crop_stage, n.days_after_onset_max = toFloat(row.days_after_onset_max), n.dry_spell_days_max = toFloat(row.dry_spell_days_max), n.dry_spell_days_min = toFloat(row.dry_spell_days_min), n.min_days = toFloat(row.min_days), n.min_rainless_days = toFloat(row.min_rainless_days), n.name = row.name, n.onset_delay_weeks = toFloat(row.onset_delay_weeks), n.onset_window = row.onset_window, n.rainless_threshold_mm = toFloat(row.rainless_threshold_mm), n.raw_text_variants = row.raw_text_variants, n.water_source = row.water_source;

LOAD CSV WITH HEADERS FROM 'file:///nodes_Crop.csv' AS row
MERGE (n:Crop {key: row.key})
SET n.category = row.category, n.name = row.name;

LOAD CSV WITH HEADERS FROM 'file:///nodes_District.csv' AS row
MERGE (n:District {key: row.key})
SET n.name = row.name, n.net_irrigated_pct = toFloat(row.net_irrigated_pct), n.rainfall_normal_mm = toFloat(row.rainfall_normal_mm);

LOAD CSV WITH HEADERS FROM 'file:///nodes_Season.csv' AS row
MERGE (n:Season {key: row.key})
SET n.name = row.name;

LOAD CSV WITH HEADERS FROM 'file:///nodes_SeasonRecord.csv' AS row
MERGE (n:SeasonRecord {key: row.key})
SET n.district = row.district, n.longest_dry_spell_days = toFloat(row.longest_dry_spell_days), n.max_3day_rain_mm = toFloat(row.max_3day_rain_mm), n.monsoon_jun_sep_mm = toFloat(row.monsoon_jun_sep_mm), n.name = row.name, n.onset_date = row.onset_date, n.onset_delay_weeks = toFloat(row.onset_delay_weeks), n.pct_departure_from_mean = toFloat(row.pct_departure_from_mean), n.rainfall_mm = toFloat(row.rainfall_mm), n.rainfall_status = row.rainfall_status, n.season = row.season, n.year = toFloat(row.year);

LOAD CSV WITH HEADERS FROM 'file:///nodes_SoilType.csv' AS row
MERGE (n:SoilType {key: row.key})
SET n.name = row.name;

LOAD CSV WITH HEADERS FROM 'file:///nodes_Year.csv' AS row
MERGE (n:Year {key: row.key})
SET n.name = row.name, n.year = toFloat(row.year);


LOAD CSV WITH HEADERS FROM 'file:///rels_APPLIES_TO_CROP.csv' AS row
CALL { WITH row
  MATCH (a:Crop {key: row.start}), (b:Action {key: row.end})
  CREATE (a)-[r:APPLIES_TO_CROP]->(b)
} IN TRANSACTIONS OF 500 ROWS;

LOAD CSV WITH HEADERS FROM 'file:///rels_EXPERIENCED.csv' AS row
CALL { WITH row
  MATCH (a:SeasonRecord {key: row.start}), (b:ConditionDetail {key: row.end})
  CREATE (a)-[r:EXPERIENCED]->(b)
  SET r.basis = row.basis, r.evidence = row.evidence
} IN TRANSACTIONS OF 500 ROWS;

