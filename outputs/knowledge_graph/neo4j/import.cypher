LOAD CSV WITH HEADERS FROM 'file:///rels_NOT_APPLICABLE.csv' AS row
CALL { WITH row
  MATCH (a:District {key: row.start}), (b {key: row.end})
  CREATE (a)-[r:NOT_APPLICABLE]->(b)
