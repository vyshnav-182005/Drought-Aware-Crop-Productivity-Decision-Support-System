  MATCH (a:ConditionDetail {key: row.start}), (b:Action {key: row.end})
  CREATE (a)-[r:RECOMMENDS]->(b)
  SET r.condition_category = row.condition_category, r.condition_detail_raw = row.condition_detail_raw, r.continued_on_page = toFloat(row.continued_on_page), r.crop = row.crop, r.crop_group = row.crop_group, r.crop_stage = row.crop_stage, r.district = row.district, r.ditto_resolved = row.ditto_resolved, r.moisture_regime = row.moisture_regime, r.season = row.season, r.season_basis = row.season_basis, r.situation = row.situation, r.soil_type = row.soil_type, r.soil_type_raw = row.soil_type_raw, r.source_page = toFloat(row.source_page), r.table_scheme = row.table_scheme
} IN TRANSACTIONS OF 500 ROWS;

